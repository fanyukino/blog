---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, CATEGORIES } from '../consts';
import { matchesCategory, categoryHref } from '../utils';

const posts = (await getCollection('posts')).filter((post) => !post.data.hidden);

// 按分类归类；不属于任何分类的文章（仓库根目录）归入「其他」
const categorized = CATEGORIES.map((cat) => ({
  ...cat,
  posts: posts
    .filter((post) => matchesCategory(post.id, cat))
    .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)),
}));

const uncategorized = posts
  .filter((post) => !CATEGORIES.some((cat) => matchesCategory(post.id, cat)))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const total =
  categorized.reduce((n, cat) => n + cat.posts.length, 0) + uncategorized.length;
---

<Layout>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
  </section>
  {
    total === 0 && (
      <p class="empty">
        暂无文章。在仓库的分类文件夹（如 cs/、daily/）中添加 Markdown
        文件后会自动展示。
      </p>
    )
  }
  {
    categorized.map((cat) => (
      <section class="category">
        <h2 class="category-title">{cat.label}</h2>
        {
          cat.posts.length > 0 ? (
            <div class="post-list">
              {cat.posts.slice(0, 3).map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p class="empty-cat">暂无内容</p>
          )
        }
        {cat.posts.length > 3 && (
          <a class="more-link" href={categoryHref(cat.slug)}>
            查看全部 {cat.posts.length} 篇 →
          </a>
        )}
      </section>
    ))
  }
  {
    uncategorized.length > 0 && (
      <section class="category">
        <h2 class="category-title">其他</h2>
        <div class="post-list">
          {uncategorized.slice(0, 3).map((post) => (
            <PostCard post={post} />
          ))}
        </div>
        {uncategorized.length > 3 && (
          <a class="more-link" href={categoryHref('other')}>
            查看全部 {uncategorized.length} 篇 →
          </a>
        )}
      </section>
    )
  }
</Layout>
