---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { homeHref } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((post) => !post.data.hidden);
  const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));
  return [...tags].map((tag) => ({ params: { tag }, props: { tag } }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;

const posts = (await getCollection('posts')).filter(
  (post) => !post.data.hidden && (post.data.tags ?? []).includes(tag),
);
const sorted = [...posts].sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<Layout title={`标签：${tag}`}>
  <header class="page-header">
    <a class="back-link" href={homeHref}>← 返回首页</a>
    <h1>#{tag}</h1>
    <p class="page-count">{sorted.length} 篇文章</p>
  </header>
  <div class="post-list">
    {sorted.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</Layout>
