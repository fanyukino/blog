---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { homeHref } from '../utils';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${homeHref}/favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-title" href={homeHref}>{SITE_TITLE}</a>
        <nav class="site-nav">
          <a href={homeHref}>首页</a>
          <a href={`${homeHref}/tags/`}>标签</a>
        </nav>
        <form class="site-search" action={`${homeHref}/search/`} method="get">
          <input type="search" name="q" placeholder="搜索…" aria-label="搜索" />
        </form>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
    </footer>
  </body>
</html>
