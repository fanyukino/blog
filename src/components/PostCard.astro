---
import { postHref, tagHref, formatDate, firstHeading, baseName } from '../utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const tags = post.data.tags ?? [];
---

<article class="post-card">
  <h3>
    <a href={postHref(post.id)}>
      {post.data.title ?? firstHeading(post.body ?? '') ?? baseName(post.id)}
    </a>
  </h3>
  {post.data.description && <p class="post-desc">{post.data.description}</p>}
  {(post.data.date || tags.length > 0) && (
    <div class="post-meta-row">
      {post.data.date && (
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
      )}
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a class="tag-chip" href={tagHref(tag)}>#{tag}</a>
          ))}
        </div>
      )}
    </div>
  )}
</article>
